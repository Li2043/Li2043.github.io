---
import { profile } from "../data/profile";
import { publicAssetExists } from "../lib/assets";
import MediaFrame from "./MediaFrame.astro";

const video = "/videos/exp01-baseline.webp";
const poster = "/images/research/fair-marl/exp01-keyframe.png";
const hasVideo = publicAssetExists(video);
const cvReady = publicAssetExists(profile.cvPath);
---

<section class="mx-auto grid max-w-6xl items-center gap-12 px-5 py-16 md:px-8 md:py-24 lg:grid-cols-[1.15fr_0.85fr]">
  <div class="reveal">
    <p class="text-xs font-medium uppercase tracking-[0.18em] text-accent">Li Shen</p>
    <h1 class="display mt-4 text-5xl text-ink md:text-6xl lg:text-7xl">Li Shen</h1>
    <p class="mt-4 text-base text-muted md:text-lg">{profile.descriptor}</p>
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink/90 md:text-xl">{profile.statement}</p>
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a href="/research/fair-marl/" class="rounded-full bg-accent px-5 py-2.5 text-sm text-white hover:bg-[#243462]">
        Explore my research
      </a>
      {
        cvReady ? (
          <a href={profile.cvPath} class="rounded-full border border-line bg-panel px-5 py-2.5 text-sm hover:border-accent/40">
            CV
          </a>
        ) : (
          <span class="rounded-full border border-dashed border-line px-5 py-2.5 text-sm text-muted" title="Add public/docs/Li_Shen_Academic_CV.pdf">
            CV
          </span>
        )
      }
    </div>
    <p class="mt-5 flex gap-5 text-sm">
      <a class="text-muted underline-offset-4 hover:text-ink hover:underline" href={profile.github} target="_blank" rel="noreferrer">GitHub</a>
      <a class="text-muted underline-offset-4 hover:text-ink hover:underline" href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
    </p>
  </div>
  <div class="reveal">
    <MediaFrame
      videoSrc={hasVideo ? video : null}
      poster={poster}
      alt="Representative Baseline highway-merging episode with four vehicles"
      caption="Four-agent highway-merging MARL · representative episode"
      autoplay={hasVideo}
      comingSoon={!hasVideo}
      eager
    />
  </div>
</section>
