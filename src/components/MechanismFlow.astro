---
import { mechanismSteps } from "../data/research";
---

<ol class="grid gap-4 lg:grid-cols-6">
  {
    mechanismSteps.map((step, i) => (
      <li class="relative rounded-2xl border border-line bg-panel p-4">
        <p class="text-xs text-muted">{String(i + 1).padStart(2, "0")}</p>
        <p class="mt-2 text-sm font-medium leading-snug">{step.title}</p>
        {step.note && <p class="mt-3 text-xs leading-snug text-teal">{step.note}</p>}
        {i < mechanismSteps.length - 1 && (
          <span class="mt-3 block text-accent lg:absolute lg:-right-3 lg:top-1/2 lg:mt-0" aria-hidden="true">
            <svg class="h-4 w-4 rotate-90 lg:rotate-0" viewBox="0 0 16 16" fill="none">
              <path class="flow-line" d="M2 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.2" />
            </svg>
          </span>
        )}
      </li>
    ))
  }
</ol>
