---
import { experiments, type Experiment } from "../data/experiments";
import { publicAssetExists } from "../lib/assets";
import EvidenceBadge from "./EvidenceBadge.astro";
import ExperimentTab from "./ExperimentTab.astro";
import MediaFrame from "./MediaFrame.astro";

interface View extends Experiment {
  hasVideo: boolean;
}

const views: View[] = experiments.map((experiment) => ({
  ...experiment,
  hasVideo: publicAssetExists(experiment.videoPath),
}));
---

<div class="grid gap-6 lg:grid-cols-[16.5rem_minmax(0,1fr)]" data-explorer>
  <div
    role="tablist"
    aria-label="Experiments"
    aria-orientation="vertical"
    class="flex gap-2 overflow-x-auto pb-1 lg:flex-col lg:overflow-visible"
  >
    {views.map((item, index) => <ExperimentTab id={item.id} code={item.code} label={item.label} selected={index === 0} />)}
  </div>

  <div>
    {
      views.map((item, index) => (
        <section
          role="tabpanel"
          id={`panel-${item.id}`}
          data-id={item.id}
          aria-labelledby={`tab-${item.id}`}
          hidden={index !== 0}
          class="grid gap-5"
        >
          <MediaFrame
            videoSrc={item.hasVideo ? item.videoPath : null}
            poster={item.posterPath}
            alt={`${item.code} ${item.label}: illustrative highway-merging episode`}
            managed={true}
            comingSoon={!item.hasVideo}
          />
          <div class="flex flex-col gap-3">
            <EvidenceBadge label={item.caveat} tone={item.evidenceType === "reconstructed" ? "reconstructed" : "neutral"} />
            <h3 class="display text-2xl md:text-3xl">{item.researchQuestion}</h3>
            <p class="max-w-3xl leading-relaxed text-muted">{item.description}</p>
            <p class="text-sm text-muted">{item.metadata}</p>
          </div>
        </section>
      ))
    }
  </div>
</div>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function activate(root: HTMLElement, id: string, play: boolean) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    root.dataset.current = id;
    for (const tab of tabs) {
      const on = tab.dataset.id === id;
      tab.setAttribute("aria-selected", on ? "true" : "false");
      tab.tabIndex = on ? 0 : -1;
      tab.classList.toggle("border-accent", on);
      tab.classList.toggle("bg-accent-soft", on);
      tab.classList.toggle("border-transparent", !on);
    }
    for (const panel of panels) {
      const on = panel.dataset.id === id;
      panel.hidden = !on;
      const video = panel.querySelector("video");
      if (!video) continue;
      if (!on) {
        video.pause();
        continue;
      }
      const src = video.dataset.src;
      if (play && src && video.getAttribute("src") !== src) video.src = src;
      if (play && !reduce && src) video.play().catch(() => undefined);
      if (!play) video.pause();
    }
  }

  document.querySelectorAll<HTMLElement>("[data-explorer]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const first = tabs[0]?.dataset.id ?? "";
    const show = (id: string) => activate(root, id, root.getBoundingClientRect().top < window.innerHeight * 0.92);
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activate(root, tab.dataset.id ?? "", true));
      tab.addEventListener("keydown", (event) => {
        const horizontal = window.matchMedia("(max-width: 1023px)").matches;
        const list = root.querySelector('[role="tablist"]');
        if (list) list.setAttribute("aria-orientation", horizontal ? "horizontal" : "vertical");
        const prevKey = horizontal ? "ArrowLeft" : "ArrowUp";
        const nextKey = horizontal ? "ArrowRight" : "ArrowDown";
        if (![prevKey, nextKey, "Home", "End"].includes(event.key)) return;
        event.preventDefault();
        let next = index;
        if (event.key === prevKey) next = (index - 1 + tabs.length) % tabs.length;
        if (event.key === nextKey) next = (index + 1) % tabs.length;
        if (event.key === "Home") next = 0;
        if (event.key === "End") next = tabs.length - 1;
        const target = tabs[next];
        if (!target) return;
        target.focus();
        activate(root, target.dataset.id ?? "", true);
      });
    });
    if (first) show(first);
    const watcher = new IntersectionObserver(
      (entries) => {
        const visible = entries.some((entry) => entry.isIntersecting);
        const id = root.dataset.current || first;
        if (id) activate(root, id, visible);
      },
      { threshold: 0.25 },
    );
    watcher.observe(root);
  });
</script>
