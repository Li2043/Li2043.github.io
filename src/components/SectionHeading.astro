---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  id?: string;
}
const { eyebrow, title, lede, id } = Astro.props;
---

<div class="max-w-3xl" id={id}>
  {eyebrow && <p class="mb-3 text-xs font-medium uppercase tracking-[0.16em] text-accent">{eyebrow}</p>}
  <h2 class="display text-3xl text-ink md:text-4xl">{title}</h2>
  {lede && <p class="mt-4 text-lg leading-relaxed text-muted">{lede}</p>}
</div>
