---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ResearchNav from "../../components/ResearchNav.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import MediaFrame from "../../components/MediaFrame.astro";
import EvidenceBadge from "../../components/EvidenceBadge.astro";
import WelfareCard from "../../components/WelfareCard.astro";
import ResearchPipeline from "../../components/ResearchPipeline.astro";
import ExperimentExplorer from "../../components/ExperimentExplorer.astro";
import MechanismFlow from "../../components/MechanismFlow.astro";
import MetricChip from "../../components/MetricChip.astro";
import CTAGroup from "../../components/CTAGroup.astro";
import { profile } from "../../data/profile";
import { findings, limitations, rigour, thesisFigures } from "../../data/research";
import { publicAssetExists } from "../../lib/assets";

const video = "/videos/exp01-baseline.webp";
const hasVideo = publicAssetExists(video);
const thesisReady = publicAssetExists(profile.thesisPath);
---

<BaseLayout
  title="Fairness in Multi-Agent Reinforcement Learning — Li Shen"
  description="MSc research on whether social-welfare objectives can make four-agent highway merging fairer, not only successful."
>
  <ResearchNav />

  <section class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-14 md:px-8 lg:grid-cols-[1.05fr_0.95fr]">
    <div>
      <p class="text-xs uppercase tracking-[0.16em] text-accent">MSc Dissertation · University of Bristol · 2026</p>
      <h1 class="display mt-4 text-4xl md:text-6xl">Can AI coordinate fairly, not just successfully?</h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">
        When several AI agents cooperate, a task can succeed while the cost of cooperation is distributed unevenly. My MSc research asked whether social-welfare objectives can make that coordination fairer.
      </p>
      <div class="mt-6">
        <CTAGroup
          links={[
            {
              label: "Full dissertation (PDF)",
              href: profile.thesisPath,
              disabled: !thesisReady,
              note: "Add public/docs/Li_Shen_MSc_Thesis.pdf",
            },
            { label: "Code", href: profile.thesisRepo, external: true },
            { label: "Back to homepage", href: "/" },
          ]}
        />
      </div>
    </div>
    <div>
      <MediaFrame
        videoSrc={hasVideo ? video : null}
        poster="/images/research/fair-marl/exp01-keyframe.png"
        alt="Baseline representative episode of four vehicles merging"
        autoplay={hasVideo}
        comingSoon={!hasVideo}
        eager
      />
      <div class="mt-3">
        <EvidenceBadge label="Representative episode · illustrative, not aggregate evidence" />
      </div>
    </div>
  </section>

  <section id="question" class="mx-auto max-w-6xl px-5 py-12 md:px-8">
    <SectionHeading title="The problem" lede="Task success is a group-level outcome. Welfare is experienced by individual agents." />
    <div class="mt-8 grid items-center gap-4 rounded-[1.6rem] border border-line bg-panel p-6 md:grid-cols-[1fr_auto_1fr_auto_1fr] md:p-8">
      <p class="text-center text-lg">Four vehicles</p>
      <span class="hidden text-accent md:block" aria-hidden="true">→</span>
      <p class="text-center text-lg">Successful merge</p>
      <span class="hidden text-accent md:block" aria-hidden="true">→</span>
      <p class="text-center text-lg">Unequal mobility cost may still occur</p>
    </div>
    <p class="mt-6 max-w-3xl text-lg leading-relaxed text-muted">
      A vehicle can visibly yield or brake without necessarily carrying the greatest requirement-relative mobility burden.
    </p>
  </section>

  <section id="fairness" class="mx-auto max-w-6xl px-5 py-12 md:px-8">
    <SectionHeading eyebrow="What does “fair” mean?" title="Three ways of aggregating individual welfare" />
    <div class="mt-8 grid gap-4 lg:grid-cols-3">
      <WelfareCard
        variant="mean"
        heading="Mean welfare"
        text="All individual welfare contributes equally to the group objective."
      />
      <WelfareCard
        variant="gini"
        heading="Generalized Gini"
        text="Lower-ranked utilities receive greater weight while the whole distribution still matters."
      />
      <WelfareCard
        variant="maximin"
        heading="Maximin"
        text="The group objective is determined by the worst-off individual."
      />
    </div>
    <details class="mt-6 rounded-2xl border border-line bg-panel px-5 py-4">
      <summary class="cursor-pointer text-base font-medium">Technical formulation</summary>
      <p class="mt-3 max-w-3xl text-lg leading-relaxed text-muted">
        The dissertation defines mean welfare, generalized Gini welfare, and Rawlsian maximin over individual utilities. Those formulas are not copied onto this page.
      </p>
    </details>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-12 md:px-8">
    <SectionHeading title="Experimental setup" lede="Each condition is a trained policy, not a single episode." />
    <div class="mt-8">
      <ResearchPipeline />
    </div>
  </section>

  <section id="experiments" class="mx-auto max-w-6xl px-5 py-12 md:px-8">
    <SectionHeading
      eyebrow="Experiment explorer"
      title="Five ways of asking the same question"
      lede="Each clip is one representative episode, shown until the vehicles have joined the mainline. The 12-seed comparisons are in the figures below, not in these animations."
    />
    <div class="mt-8">
      <ExperimentExplorer />
    </div>
  </section>

  <section id="results" class="mx-auto max-w-6xl px-5 py-14 md:px-8">
    <SectionHeading
      eyebrow="Dissertation figures"
      title="The 12-seed results, as plotted in the thesis"
      lede="These are the aggregate figures. They are not inferred from the single episodes above."
    />
    <div class="mt-8 space-y-8">
      {
        thesisFigures.map((figure) => (
          <figure class="overflow-hidden rounded-[1.4rem] border border-line bg-panel">
            <img src={figure.src} alt={figure.alt} class="w-full bg-white" loading="lazy" decoding="async" />
            <figcaption class="px-5 py-4 text-lg leading-relaxed text-muted">{figure.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section id="findings" class="mx-auto max-w-6xl px-5 py-14 md:px-8">
    <p class="display max-w-4xl text-4xl md:text-5xl">Changing the welfare objective alone was not enough.</p>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      <article class="rounded-[1.4rem] border border-line bg-panel p-6">
        <h2 class="text-xs uppercase tracking-[0.16em] text-muted">Expected</h2>
        <p class="mt-4 text-lg leading-relaxed">Fair objective → fair behaviour → fair outcome</p>
      </article>
      <article class="rounded-[1.4rem] border border-line bg-accent-soft p-6">
        <h2 class="text-xs uppercase tracking-[0.16em] text-accent">Observed</h2>
        <p class="mt-4 text-lg leading-relaxed">
          Fair objective → limited or unstable local influence → inconsistent final welfare improvement
        </p>
      </article>
    </div>
    <p class="mt-6 max-w-3xl text-lg leading-relaxed text-muted">
      This is not a claim that social-welfare optimisation is generally ineffective. In this decentralised setting, the aggregation rule alone was too indirect to reliably produce stable redistribution.
    </p>
    <ol class="mt-10 grid gap-5">
      {
        findings.map((item) => (
          <li class="grid gap-3 border-t border-line py-6 md:grid-cols-[5rem_1fr]">
            <span class="display text-3xl text-accent">{item.n}</span>
            <div>
              <h3 class="display text-2xl">{item.title}</h3>
              <p class="mt-2 max-w-3xl text-lg leading-relaxed text-muted">{item.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="mechanisms" class="mx-auto max-w-6xl px-5 py-12 md:px-8">
    <SectionHeading title="Where a fairness objective can fail to change the outcome" />
    <div class="mt-8">
      <MechanismFlow />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-12 md:px-8">
    <SectionHeading title="How I evaluated the system" />
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {rigour.map((item) => <MetricChip value={item.value} label={item.label} />)}
    </div>
    <p class="mt-5 max-w-3xl text-lg leading-relaxed text-muted">
      Individual evaluation episodes were not treated as independent training replications. Intervals come from differences between the 12 training seeds.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-12 md:px-8">
    <SectionHeading title="Limitations" />
    <ul class="mt-6 max-w-3xl space-y-3 text-lg text-muted">
      {limitations.map((item) => <li class="border-l border-line pl-4">{item}</li>)}
    </ul>
  </section>

  <section id="reflection" class="mx-auto max-w-6xl px-5 py-16 md:px-8">
    <blockquote class="display max-w-4xl text-3xl leading-snug md:text-4xl">
      Fairness is not only an objective-function problem. It is also an information, credit-assignment, and mechanism-design problem.
    </blockquote>
    <p class="mt-6 max-w-3xl text-lg leading-relaxed text-muted">
      This project shifted my interest from choosing a “fair” objective toward understanding how individual-level signals actually enter algorithmic decisions and become — or fail to become — collective outcomes.
    </p>
    <h2 class="display mt-12 text-3xl">Where I want to go next</h2>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-muted">
      This work made me increasingly interested in how AI systems aggregate signals from multiple individuals. I am particularly interested in human-in-the-loop settings where collective decisions, consensus, or rankings should emerge from human interaction rather than from a single predefined objective.
    </p>
    <div class="mt-8">
      <CTAGroup
        links={[
          {
            label: "Read the full thesis",
            href: profile.thesisPath,
            disabled: !thesisReady,
            note: "Add public/docs/Li_Shen_MSc_Thesis.pdf",
          },
          { label: "View the code", href: profile.thesisRepo, external: true },
          { label: "Back to research", href: "/#research" },
        ]}
      />
    </div>
  </section>
</BaseLayout>
